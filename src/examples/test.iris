#A file used to test concepts in Iris. This was moved from libs to examples!#

#P.S. We just tested comments :)#

var to_be = 3; # Testing if vars work #

checks (to_be) { # testing the checks keyword (Iris' version of 'switch') #
    (1): {
        print("ONE%n");
    },
    (2): {
        print("TWO%n");
    },
    (3): {
        print("THREE%n");
    }
};

class Creature {
    "type" : 1,
    "type_conv" : "null",
    "name" : "Rob",
    "age" : 0,
    "height" : 180,
    "width" : 60
};

func creature_type(classtype) {
    classtype = toNumber(classtype);
    var returnvar = "";
    checks (classtype) { # cannot take direct data from class (e.g. ClassName."example") #
        (1): {
            returnvar = "Plant";
        },
        (2): {
            returnvar = "Mammal";
        },
        (3): {
            returnvar = "Fish";
        },
        (4): {
            returnvar = "Fungus";
        },
        (5): {
            returnvar = "Bacteria";
        }
    };

    return returnvar;
};

Creature Henry;
Henry."name" = "Henry";
Henry."type_conv" = creature_type(Henry."type");

print("Henry is a ", Henry."type_conv", "!%n");
