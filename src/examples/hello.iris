print("%n");

var x = 35;
var t = 45.4;

print(x, " : ", type(x), "%n");
print(t, " : ", type(t), "%n");

const hi = "v";
var bye = hi;

print(bye, "%n");

# var o : number = 3; errors, since a number isnt an integer #
# var l : number = 2; errors, since a number isnt an integer #

var o : integer = 3; # works! #
var l : integer = 2; # works! #

print(o + l, "%n");

