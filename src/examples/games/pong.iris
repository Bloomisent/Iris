include <strings>;
include <arrays>;
include <ui>;

var sheight = 400;
var swidth = 500;

dict player_pos = ["x":10,"y":sheight/2];
dict opponent_pos = ["x":swidth-15,"y":sheight/2];
dict circle_pos = ["x":swidth/2,"y":sheight/2];

Rectangle plr;
plr.x = dict_get_from_index(player_pos, "x");
plr.y = dict_get_from_index(player_pos, "y");
plr.w = 3;
plr.h = 15;
plr.bgR = 255;
plr.bgG = 255;
plr.bgB = 255;

Rectangle opp;
opp.x = dict_get_from_index(opponent_pos, "x");
opp.y = dict_get_from_index(opponent_pos, "y");
opp.w = 3;
opp.h = 15;
opp.bgR = 255;
opp.bgG = 255;
opp.bgB = 255;

Rectangle circle;
circle.x = dict_get_from_index(circle_pos, "x");
circle.y = dict_get_from_index(circle_pos, "y");
circle.w = 6;
circle.h = 6;
circle.bgR = 255;
circle.bgG = 255;
circle.bgB = 255;

Rectangle circle_hitbox;
circle_hitbox.x = dict_get_from_index(circle_pos, "x");
circle_hitbox.y = dict_get_from_index(circle_pos, "y");
circle_hitbox.w = 10;
circle_hitbox.h = 10;
circle_hitbox.bgR = 255;
circle_hitbox.bgG = 255;
circle_hitbox.bgB = 255;

Rectangle divider;
divider.x = swidth/2;
divider.y = 0;
divider.w = 1.5;
divider.h = sheight;
divider.bgR = 255;
divider.bgG = 255;
divider.bgB = 255;

Text plr_score_txt;
plr_score_txt.x = swidth - (swidth/4*3);
plr_score_txt.y = 25;
plr_score_txt.w = 30;
plr_score_txt.h = 30;
plr_score_txt.bgR = 255;
plr_score_txt.bgG = 255;
plr_score_txt.bgB = 255;
plr_score_txt.text = "0";

Text bot_score_txt;
bot_score_txt.x = (swidth/4)*3;
bot_score_txt.y = 25;
bot_score_txt.w = 30;
bot_score_txt.h = 30;
bot_score_txt.bgR = 255;
bot_score_txt.bgG = 255;
bot_score_txt.bgB = 255;
bot_score_txt.text = "0";

var player_score = 0;
var opponent_score = 0;

func checkRectIntersection(r1, r2) {
    return (r1.x < r2.x + r2.w &&
            r1.x + r1.w > r2.x &&
            r1.y < r2.y + r2.h &&
            r1.y + r1.h > r2.y);
};

func updateScore(){
    plr_score_txt.text = toString(player_score);
    bot_score_txt.text = toString(opponent_score);
};

func start() {
    windowCreate("Iris Ball Game", swidth, sheight);

    var delta = 1;
    var speed = 0.072;

    var plr_speed = 0.725;

    var time = 0.75;
    var base = -0.125;
    var offset = base;

    var opp_track = true;

    while (windowShouldClose() == 0) {
        #delta = floor(windowGetTime(), 100);#
        windowClear(0, 0, 0);

        updateScore();
        sheight = windowGetHeight();
        swidth = windowGetWidth();

        divider.x = swidth/2;
        divider.h = sheight;

        plr_score_txt.x = swidth - (swidth/4*3);

        Text bot_score_txt;
        bot_score_txt.x = (swidth/4)*3;

        if (player_pos.y > (sheight - plr."h")){
            player_pos.y = (sheight - plr."h");
        };
        if (player_pos.y < 15){
            player_pos.y = 15;
        };

        if (windowKeyPressed("W")){
            player_pos.y -= plr_speed * delta;
            #print("forward%n");#
        };
        if (windowKeyPressed("S")){
            player_pos.y += plr_speed * delta;
            #print("backward%n");#
        };

        if (opp_track == true) {
            opponent_pos.y = circle_pos.y; #(circle_pos.y + player_pos.y) / 2 + offset;#
        };

        plr.x = player_pos.x;
        plr.y = player_pos.y;

        opp.x = opponent_pos.x;
        opp.y = opponent_pos.y;

        circle_pos.x += base + (speed * time) * player_score;
        circle_pos.y += offset + (speed * time) * player_score;

        if (circle_pos.x < 0) {
            circle_pos.x = swidth/2;
            offset = 1;
            opponent_score += 1;
        };
        if (circle_pos.x > swidth) {
            circle_pos.x = swidth/2;
            offset = 1;
            player_score += 1;
        };
        if (circle_pos.y < 0) {
            offset *= -1;
        };
        if (circle_pos.y > sheight-(circle.h)) {
            offset *= -1;
        };

        circle.x = circle_pos.x;
        circle.y = circle_pos.y;

        circle_hitbox.x = circle_pos.x;
        circle_hitbox.y = circle_pos.y;

        uiRectangleDraw(plr);
        uiRectangleDraw(opp);
        uiRectangleDraw(circle);

        if (checkRectIntersection(plr, circle_hitbox)){
            base = 0.125;
            opp_track = true;
            ifelse (plr.y >= circle.y){
                offset = plr.y - circle.y;
            } else {
                offset = circle.y - plr.y;
            };
            if (base > 3) {
                base = 3;
            };
        };

        if (checkRectIntersection(opp, circle_hitbox)){
            base = -0.125;
            opp_track = false;
            ifelse (opp.y >= circle.y){
                offset = opp.y - circle.y;
            } else {
                offset = circle.y - opp.y;
            };
            if (offset > 3){
                offset = 3;
            };
        };

        # Barrier #

        uiRectangleDraw(divider);

        # Scores #

        uiTextDraw(plr_score_txt);
        uiTextDraw(bot_score_txt);

        windowPresent();
    };
    windowClose();
};

start();
gc();
