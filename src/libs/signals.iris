var Signal_Id_Available = 0;

# ============================================ #
#                  Signal                      #
# ============================================ #

class Signal {
    "name" : null,
    "id" : 0,
    "connections" : [],

    "init" : func(self, name){
        self.name = name;
        self.id = Signal_Id_Available;

        Signal_Id_Available += 1;
    },

    "connect" : func(self, function){
        self.connections[self.id] = function;
    },

    "fire" : func(self, value){
        for key, function in self.connections {
            function(value);
        };
    }
};


# ============================================ #
#                  Creation                    #
# ============================================ #

func signal_create(name){
    Signal d;
    d.init(name);

    return d;
};


# ============================================ #
#                  Runtime                     #
# ============================================ #

func signal_runtime(signal, value){
    signal.fire(value);
};

