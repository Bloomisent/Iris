const PI = 3.14159265358979323846;
const pi = 3.14159265358979323846;

func abs(n) {
    if (n < 0) {
        return 0 - n;
    };
    return n;
};

func max(a, b) {
    if (a > b) {
        return a;
    };
    return b;
};

func min(a, b) {
    if (a < b) {
        return a;
    };
    return b;
};

func clamp(value, low, high) {
    return max(low, min(value, high));
};

# used while modulo system hasn't been developed yet #

func isEven(n) {
    return (n % 2) == 0;
};

func isOdd(n) {
    return (n % 2) != 0;
};

# Newton's method -- converges to float precision well within 25 iterations #
func sqrt(n) {
    if (n < 0) {
        print("sqrt: cannot compute square root of a negative number%n");
        return 0;
    };
    if (n == 0) {
        return 0;
    };

    var guess = n;
    var i = 0;
    while (i < 25) {
        guess = (guess + n / guess) / 2;
        i = i + 1;
    };
    return guess;
};

func factorial(n) {
    if (n <= 1) {
        return 1;
    };
    return n * factorial(n - 1);
};

# Euclidean algorithm #
func gcd(a, b) {
    if (b == 0) {
        return a;
    };
    return gcd(b, a % b);
};

func lcm(a, b) {
    return (a * b) / gcd(a, b);
};

# sum/average over a 1-indexed table of `size` numbers #
func sum(t, size) {
    var total = 0;
    var i = 1;
    while (i <= size) {
        total = total + table_get_from_index(t, i);
        i = i + 1;
    };
    return total;
};

func average(t, size) {
    return sum(t, size) / size;
};

func reduce_range(x) {
    var two_pi = pi * 2;
    var quotients = x / two_pi;
    x = x - (quotients * two_pi);

    if (x > pi) {
        x -= two_pi;
    } else if (x < -pi) {
        x += two_pi;
    };
    return x;
};

func sin(x) {
    x = reduce_range(x);

    var term = x;
    var sum = x;
    var x_squared = x * x;

    for (var i = 3: i <= 31: "--") {
        term = -term * x_squared / (i * (i - 1));
        sum += term;
        i += 3;
    };

    return sum;
};

func cos(x) {
    x = reduce_range(x);

    var term = 1.0;
    var sum = 1.0;
    var x_squared = x * x;

    for (var i = 2: i <= 30: "--") {
        term = -term * x_squared / (i * (i - 1));
        sum += term;
        i += 3;
    };
    return sum;
};

func tan(x) {
    var c = cos(x);
    if (c == 0) {
        return 0;
    };
    return (sin(x) / c);
};
