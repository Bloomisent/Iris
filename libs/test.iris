# test.iris -- a minimal assertion framework. #

var __test_pass_count = 0;
var __test_fail_count = 0;

func assertEqual(actual, expected, label) {
    if (type(actual) != type(expected)) {
        __test_fail_count = __test_fail_count + 1;
        print("FAIL: ", label, " -- type mismatch (expected ", type(expected), ", got ", type(actual), ")%n");
        return 0;
    };

    ifelse (actual == expected) {
        __test_pass_count = __test_pass_count + 1;
        print("PASS: ", label, "%n");
    } else {
        __test_fail_count = __test_fail_count + 1;
        print("FAIL: ", label, " -- expected ", expected, " but got ", actual, "%n");
    };
    return 0;
};

func assertTrue(cond, label) {
    ifelse (cond) {
        __test_pass_count = __test_pass_count + 1;
        print("PASS: ", label, "%n");
    } else {
        __test_fail_count = __test_fail_count + 1;
        print("FAIL: ", label, " -- expected true, got false%n");
    };
    return 0;
};

func assertFalse(cond, label) {
    ifelse (cond) {
        __test_fail_count = __test_fail_count + 1;
        print("FAIL: ", label, " -- expected false, got true%n");
    } else {
        __test_pass_count = __test_pass_count + 1;
        print("PASS: ", label, "%n");
    };
    return 0;
};

func testSummary() {
    print("%n--- ", __test_pass_count, " passed, ", __test_fail_count, " failed ---%n");
    return 0;
};
