# ============================================================#
# Iris Self-Hosted Lexer#
# ============================================================#

var TOKEN_NUMBER = "NUMBER";
var TOKEN_STRING = "STRING";
var TOKEN_IDENTIFIER = "IDENTIFIER";

var TOKEN_PLUS = "PLUS";
var TOKEN_MINUS = "MINUS";
var TOKEN_STAR = "STAR";
var TOKEN_SLASH = "SLASH";
var TOKEN_PERCENT = "PERCENT";
var TOKEN_CARET = "CARET";

var TOKEN_EQUAL = "EQUAL";
var TOKEN_EQUAL_EQUAL = "EQUAL_EQUAL";
var TOKEN_NOT_EQUAL = "NOT_EQUAL";

var TOKEN_GREATER = "GREATER";
var TOKEN_GREATER_EQUAL = "GREATER_EQUAL";
var TOKEN_LESS = "LESS";
var TOKEN_LESS_EQUAL = "LESS_EQUAL";

var TOKEN_LEFT_PAREN = "LEFT_PAREN";
var TOKEN_RIGHT_PAREN = "RIGHT_PAREN";

var TOKEN_LEFT_BRACE = "LEFT_BRACE";
var TOKEN_RIGHT_BRACE = "RIGHT_BRACE";

var TOKEN_LEFT_BRACKET = "LEFT_BRACKET";
var TOKEN_RIGHT_BRACKET = "RIGHT_BRACKET";

var TOKEN_COMMA = "COMMA";
var TOKEN_COLON = "COLON";
var TOKEN_DOT = "DOT";
var TOKEN_SEMICOLON = "SEMICOLON";

var TOKEN_EOF = "EOF";

func token(kind, value, line) {
    dict v = [
        "type": kind,
        "value": value,
        "line": line
    ];
    return v;
};


func isDigit(c) {
    var comp = (c >= "0" && c <= "9");
    return comp;
};


func isAlpha(c) {
    return (
        (c >= "a" && c <= "z") ||
        (c >= "A" && c <= "Z") ||
        c == "_"
    );
};


func isAlphaNumeric(c) {
    return isAlpha(c) || isDigit(c);
};


func lex(source) {

    table tokens = [];

    var length = 0;

    ForEach(source, "lexerCount");

    func lexerCount(character) {
        length += 1;
    };

    var i = 1;
    var line = 1;

    while (i <= length) {
        var on = false;
        var c = charAt(source, i);


        # Whitespace #

        if (c == " " || c == "\t" || c == "\r") {
            i += 1;
            on = true;
        };
        if (c == "\n") {
            line += 1;
            i += 1;
            on = true;
        };


        # Comments#

        if (c == "#") {

            i += 1;
            on = true;

            while (i <= length && charAt(source, i) != "#") {

                if (charAt(source, i) == "\n") {
                    line += 1;
                };

                i += 1;
            };

            if (i <= length) {
                i += 1;
            };
        };


        # Numbers#

        if (isDigit(c)) {

            on = true;

            var value = "";
            var decimal = false;

            while (i <= length) {

                var n = charAt(source, i);
                var e = false;
                if (isDigit(n)) {
                    value += n;
                    i += 1;
                    e = true;
                };
                if (n == "." && !decimal) {
                    decimal = true;
                    value += n;
                    i += 1;
                    e = true;
                };
                if (e == false) {
                    break;
                };
            };

            table_set_index(
                tokens,
                tokens.length + 1,
                token(
                    TOKEN_NUMBER,
                    toNumber(value),
                    line
                )
            );
        };


        # Strings #

        if (c == "\"") {

            i += 1;
            on = true;

            var value = "";

            while (i <= length && charAt(source, i) != "\"") {

                var n = charAt(source, i);

                ifelse (n == "\\") {

                    i += 1;

                    if (i > length) {
                        break;
                    }

                    var escaped = charAt(source, i);
                    var gay = false;

                    if (escaped == "n") {
                        value += "\n";
                        gay = true;
                    }
                    if (escaped == "t") {
                        value += "\t";
                        gay = true;
                    }
                    if (escaped == "\"") {
                        value += "\"";
                        gay = true;
                    }
                    if (escaped == "\\") {
                        value += "\\";
                        gay = true;
                    }
                    if (gay == false) {
                        value += escaped;
                    }
                } else {
                    value += n;
                }

                i += 1;
            }

            if (i <= length) {
                i += 1;
            }

            table_set_index(
                tokens,
                tokens.length + 1,
                token(
                    TOKEN_STRING,
                    value,
                    line
                )
            );
        }


        # Identifiers#

        if (isAlpha(c)) {

            var value = "";
            on = true;

            while (
                i <= length &&
                isAlphaNumeric(charAt(source, i))
            ) {
                value += charAt(source, i);
                i += 1;
            }

            table_set_index(
                tokens,
                tokens.length + 1,
                token(
                    TOKEN_IDENTIFIER,
                    value,
                    line
                )
            );
        }


        # Operators#

        if (c == "+") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_PLUS, "+", line));
            i += 1;
            on = true;
        }

        if (c == "-") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_MINUS, "-", line));
            i += 1;
            on = true;
        }

        if (c == "*") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_STAR, "*", line));
            i += 1;
            on = true;
        }

        if (c == "/") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_SLASH, "/", line));
            i += 1;
            on = true;
        }

        if (c == "%") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_PERCENT, "%", line));
            i += 1;
            on = true;
        }

        if (c == "^") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_CARET, "^", line));
            i += 1;
            on = true;
        }


        # Equals / equality#

        if (c == "=") {
            on = true;
            ifelse (
                i < length &&
                charAt(source, i + 1) == "="
            ) {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_EQUAL_EQUAL, "==", line));
                i += 2;
            }
            else {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_EQUAL, "=", line));
                i += 1;
            }
        }


        # Not equal#

        if (c == "!") {
            on = true;
            ifelse (
                i < length &&
                charAt(source, i + 1) == "="
            ) {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_NOT_EQUAL, "!=", line));
                i += 2;
            }
            else {
                print("Lexer error: unexpected !");
                i += 1;
            }
        }


        # Greater#

        if (c == ">") {
            on = true;
            ifelse (
                i < length &&
                charAt(source, i + 1) == "="
            ) {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_GREATER_EQUAL, ">=", line));
                i += 2;
            }
            else {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_GREATER, ">", line));
                i += 1;
            }
        }


        # Less#

        if (c == "<") {
            on = true;
            ifelse (
                i < length &&
                charAt(source, i + 1) == "="
            ) {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_LESS_EQUAL, "<=", line));
                i += 2;
            }
            else {
                table_set_index(tokens, tokens.length + 1,
                    token(TOKEN_LESS, "<", line));
                i += 1;
            }
        }


        # Punctuation#

        if (c == "(") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_LEFT_PAREN, "(", line));
            i += 1;
            on = true;
        }

        if (c == ")") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_RIGHT_PAREN, ")", line));
            i += 1;
            on = true;
        }

        if (c == "{") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_LEFT_BRACE, "{", line));
            i += 1;
            on = true;
        }

        if (c == "}") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_RIGHT_BRACE, "}", line));
            i += 1;
            on = true;
        }

        if (c == "[") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_LEFT_BRACKET, "[", line));
            i += 1;
            on = true;
        }

        if (c == "]") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_RIGHT_BRACKET, "]", line));
            i += 1;
            on = true;
        }

        if (c == ",") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_COMMA, ",", line));
            i += 1;
            on = true;
        }

        if (c == ":") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_COLON, ":", line));
            i += 1;
            on = true;
        }

        if (c == ".") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_DOT, ".", line));
            i += 1;
            on = true;
        }

        if (c == ";") {
            table_set_index(tokens, tokens.length + 1,
                token(TOKEN_SEMICOLON, ";", line));
            i += 1;
            on = true;
        }

        if (on == false) {
            print(
                "Lexer error at line " +
                toString(line) +
                ": " +
                c
            );

            i += 1;
        }
    }

    table_set_index(
        tokens,
        tokens.length + 1,
        token(TOKEN_EOF, "", line)
    );

    return tokens;
};
