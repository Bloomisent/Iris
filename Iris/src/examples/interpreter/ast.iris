# ============================================================#
# Iris AST#
# ============================================================#

func AST(type) {
    return [
        "type": type
    ];
}


func Number(value) {
    var node = AST("number");
    node.value = value;
    return node;
}


func String(value) {
    var node = AST("string");
    node.value = value;
    return node;
}


func Boolean(value) {
    var node = AST("boolean");
    node.value = value;
    return node;
}


func Null() {
    return AST("null");
}


func Identifier(name) {
    var node = AST("identifier");
    node.name = name;
    return node;
}


func Binary(left, operator, right) {
    var node = AST("binary");

    node.left = left;
    node.operator = operator;
    node.right = right;

    return node;
}


func Unary(operator, expression) {
    var node = AST("unary");

    node.operator = operator;
    node.expression = expression;

    return node;
}


func Variable(name, initializer) {
    var node = AST("variable");

    node.name = name;
    node.initializer = initializer;

    return node;
}


func Assignment(name, value) {
    var node = AST("assignment");

    node.name = name;
    node.value = value;

    return node;
}


func Expression(expression) {
    var node = AST("expression");

    node.expression = expression;

    return node;
}


func Block(body) {
    var node = AST("block");

    node.body = body;

    return node;
}


func If(condition, thenBranch, elseBranch) {
    var node = AST("if");

    node.condition = condition;
    node.thenBranch = thenBranch;
    node.elseBranch = elseBranch;

    return node;
}


func While(condition, body) {
    var node = AST("while");

    node.condition = condition;
    node.body = body;

    return node;
}


func Return(value) {
    var node = AST("return");

    node.value = value;

    return node;
}


func Function(name, parameters, body) {
    var node = AST("function");

    node.name = name;
    node.parameters = parameters;
    node.body = body;

    return node;
}


func Call(callee, arguments) {
    var node = AST("call");

    node.callee = callee;
    node.arguments = arguments;

    return node;
}
